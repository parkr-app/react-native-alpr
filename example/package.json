{
  "name": "react-native-alpr-example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.14",
    "expo-dev-client": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-alpr": "workspace:*",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "postinstall": "node -e \"const fs=require('fs');const p='../node_modules/react-native-alpr';if(!fs.existsSync(p))fs.symlinkSync('..',p)\""
  },
  "private": true
}
